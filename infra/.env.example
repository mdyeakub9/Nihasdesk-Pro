# Copy to .env (never commit .env). Values are placeholders; use your own strong passwords (SEC-15).

# --- docker-compose (local dependencies) ---
POSTGRES_USER=nihasdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nihasdesk
# App role (not table owner, cannot bypass RLS); created by postgres/init on first start.
APP_DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_USER=nihasdesk
RABBITMQ_PASSWORD=change-me

# --- Api / Workers (ASP.NET Core reads these as configuration) ---
# Locally, prefer `dotnet user-secrets` (see infra/README.md); in Coolify set them as secrets.
# The app connects as the app role; migrations run as the owner (SEC-11).
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=nihasdesk;Username=nihasdesk_app;Password=change-me
ConnectionStrings__PostgresMigrations=Host=localhost;Port=5432;Database=nihasdesk;Username=nihasdesk;Password=change-me
ConnectionStrings__Redis=localhost:6379,password=change-me
ConnectionStrings__RabbitMq=amqp://nihasdesk:change-me@localhost:5672/
Cors__AllowedOrigins__0=http://localhost:5173
App__DashboardUrl=http://localhost:5173

# --- Email (ADR 0008): Mailpit locally (see appsettings.Development.json); Brevo SMTP relay in deployment ---
Email__Smtp__Host=smtp-relay.brevo.com
Email__Smtp__Port=587
Email__Smtp__UseStartTls=true
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__FromAddress=

# --- Integrations (later issues) ---
LLM_PROVIDER=
LLM_API_KEY=
META_APP_ID=
META_APP_SECRET=

# --- Identity (ADR 0009) ---
Identity__BreachedPasswords__Enabled=true
